# Copy to .env and adjust. All settings use the SAL_ prefix.
SAL_APP_NAME="SaaS Agent Lab"
SAL_DATABASE_URL="sqlite:///./saas_agent_lab.db"
SAL_PLANNER_MODEL="anthropic:claude-sonnet-5"
SAL_PLANNER_TIMEOUT_SECONDS=30
# The provider's key (e.g. ANTHROPIC_API_KEY) is read by its SDK from the
# process environment, not from this file. Neither the app nor the tests
# need one; tests never send a real model request.
